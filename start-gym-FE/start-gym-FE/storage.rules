rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Allow write access for authenticated users (handled by backend)
    match /{allPaths=**} {
      allow write: if false; // All writes handled by backend
    }
  }
} 